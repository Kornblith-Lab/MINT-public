"""exp_demo: train a small MINT model on a subsample of the pre-tokenized encounters."""
from os.path import join

from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import Glob, Import

Import("env", "flag")
localenv = env.Clone()

USE_SLURM = env["use_slurm"]


def _run_cmd(cmd_parts, n_cpus=2, mem="5G", use_slurm=USE_SLURM):
    full = " ".join(str(x) for x in cmd_parts)
    if use_slurm:
        full = (f"srun --nodes=1 --ntasks=1 --cpus-per-task={n_cpus} "
                f"--mem-per-cpu={mem} --time=72:00:00 {full}")
    return full


DATA_DIR = join("#", "MINT raw data", "additional")
VOCAB = join(DATA_DIR, "vocab.csv")
CONFIG = join("#", flag, "config_demo.json")
SUBSAMPLE_SCRIPT = join("#", "scripts", "subsample_tokens.py")
TRAIN_SCRIPT = join("#", "train.py")
TRAIN_CODE = [join("#", f) for f in ["model.py", "utils.py"]]
N_ENCOUNTERS = {"train": 5000, "val": 500}
N_SEEDS = 1

nest = SConsWrap(Nest(), localenv["output"], alias_environment=localenv)
nest.add("seed", range(N_SEEDS))


@nest.add_target_with_env(localenv)
def subsample(env, outdir, c):
    commands = []
    for split, n in N_ENCOUNTERS.items():
        cmd = [
            "python", "${SOURCES[0]}",
            "--feather",      "${SOURCES[1]}",
            "--vocab",        "${SOURCES[2]}",
            "--n-encounters", n,
            "--seed",         c["seed"],
            "--out-npy",      "${TARGETS[0]}",
        ]
        sources = [SUBSAMPLE_SCRIPT, join(DATA_DIR, f"{split}.feather"), VOCAB]
        commands += env.Command(join(outdir, f"{split}.npy"), sources, _run_cmd(cmd))
    return commands


@nest.add_target_with_env(localenv)
def train(env, outdir, c):
    targets = [join(outdir, "ckpt.pt"), join(outdir, "train.log")]
    cmd = [
        "python", "${SOURCES[0]}",
        "--config",    "${SOURCES[1]}",
        "--train-npy", "${SOURCES[2]}",
        "--val-npy",   "${SOURCES[3]}",
        "--vocab",     "${SOURCES[4]}",
        "--seed",      c["seed"],
        "--out-dir",   "${TARGETS[0].dir}",
        "--log",       "${TARGETS[1]}",
    ]
    sources = [TRAIN_SCRIPT, CONFIG, c["subsample"][0], c["subsample"][1], VOCAB] + TRAIN_CODE
    return env.Command(targets, sources, _run_cmd(cmd))
